{
  "name": "headerwise",
  "version": "1.0.4",
  "private": true,
  "description": "Modify HTTP request and response headers. Runs locally, sends nothing anywhere.",
  "license": "MIT",
  "repository": "github:Protemir/headerwise",
  "homepage": "https://protemir.github.io/headerwise/",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "test": "node --test tests/*.test.ts",
