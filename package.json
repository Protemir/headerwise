    "test:live": "node scripts/live-test/run.mjs",
    "store:shots": "node scripts/store/shots.mjs",
    "build:firefox": "node scripts/firefox.mjs",
    "build:automation": "node scripts/automation.mjs"
  },
  "dependencies": {
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
