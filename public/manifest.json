{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "default_locale": "en",
  "version": "1.0.2",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Headerwise",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Open Headerwise"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Pause or resume all profiles"
    },
    "next-profile": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Switch to the next profile (turns the others off)"
    }
  }
}
